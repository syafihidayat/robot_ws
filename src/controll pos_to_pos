    //marker->pose.orientation.w = 1.0;
    //marker->pose.orientation.x = 0.0;
    //marker->pose.orientation.y = 0.0;
    //marker->pose.orientation.z = 0.0;

    //marker->scale.x = 0.1;
    //marker->color.r = 1.0;
    //marker->color.g = 0.0;
    //marker->color.b = 0.0;
    //marker->color.a = 1.0;

    // geometry_msgs::msg::Point start_point;
    // start_point.x = startX;
    // start_point.y = startY;
    // start_point.z = 0.0;
    // marker->points.push_back(start_point);

    // geometry_msgs::msg::Point current_point;
    // current_point.x = currentX;
    // current_point.y = currentY;
    // current_point.z = 0.0;
    // marker->points.push_back(current_point);

    // visual_pub->publish(*marker);

  }

  void control_loop()
  {
    if (!start_received || !target_received)
      return;


    geometry_msgs::msg::Twist cmd;


    switch(current_state)
    {
      case WAITING_FOR_TARGET:
      cmd.linear.x = 0.0;
      cmd.linear.y = 0.0;
      cmd.angular.z = 0.0;
      break;

      case MOVING_TO_TARGET:
      {
        double dx = targetX - currentX;
        double dy = targetY - currentY;

        double distance_traveled = std::sqrt(dx * dx + dy * dy);

        // double error = target_distance - distance_traveled;


        if (distance_traveled > 0.01)
        {
          double angle = std::atan2(dy, dx);
          cmd.linear.x = 0.2 * std::cos(angle);
          cmd.linear.y = 0.2 * std::sin(angle);
          cmd.angular.z = 0.0;
          RCLCPP_INFO(this->get_logger(), "move robot");

        }
        else
        {
          cmd.linear.x = 0.0;
          cmd.linear.y = 0.0;
          cmd.angular.z = 0.0;

          current_state = TARGET_REACHED;
          target_received = false;

          std_msgs::msg::Bool reached_msg;
          reached_msg.data = true;
          reached_pub->publish(reached_msg);

          RCLCPP_INFO(this->get_logger(), "target reached");
          RCLCPP_INFO(this->get_logger(), "wait for next target");
        }
        break;
      }

      case TARGET_REACHED:
        cmd.linear.x = 0.0;
        cmd.linear.y = 0.0;
        cmd.angular.z = 0.0;
        break;
    }
    cmd_pub->publish(cmd);
  }  
  rclcpp::Publisher<geometry_msgs::msg::Twist>::SharedPtr cmd_pub;
  //rclcpp::Publisher<visualization_msgs::msg::Marker>::SharedPtr visual_pub; 
  rclcpp::Subscription<nav_msgs::msg::Odometry>::SharedPtr odom_sub;
  rclcpp::Subscription<geometry_msgs::msg::Point>::SharedPtr pose_sub;
  rclcpp::Publisher<std_msgs::msg::Bool>::SharedPtr reached_pub;
  rclcpp::TimerBase::SharedPtr timer_;
};

int main(int argc, char**argv)
{
  rclcpp::init(argc, argv);
  rclcpp::spin(std::make_shared<Movement>());
  rclcpp::shutdown();
  return 0;
}
